# Block every request that reaches this directory. The DocumentRoot should be
# /public; if someone points Apache here by mistake, this file still denies all.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phtml .phar .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phtml .phar .cgi .pl .py